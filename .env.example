# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ลง git — อยู่ใน .gitignore แล้ว)
# ใช้กับ local dev เท่านั้น — บน Render ให้ตั้งค่าเหล่านี้ผ่าน Dashboard > Environment แทน

# ── Gemini (ดูรายละเอียดที่ GEMINI_API_SETUP.md) ──
GEMINI_API_KEYS=

# ── Google Sheets — บันทึกประวัติผลการเล่น (ดูรายละเอียดที่ GOOGLE_SHEETS_SETUP.md) ──
# JSON ทั้งไฟล์ของ service account key (วางเป็นบรรทัดเดียว) ห้าม commit ไฟล์ credentials ลง repo เด็ดขาด
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SHEETS_SPREADSHEET_ID=
